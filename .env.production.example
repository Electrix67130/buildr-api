# ============================================================
# Buildr API — variables d'environnement PRODUCTION
# ------------------------------------------------------------
# Sur le serveur, copier en .env (lu par docker-compose.prod.yml), puis remplir.
#   cp .env.production.example .env && chmod 600 .env
# Generer les secrets :  openssl rand -hex 32
# NE JAMAIS committer .env (deja ignore par .gitignore).
# ============================================================

NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# --- Base de donnees (interne au reseau Docker) ---
# DB_HOST/DB_PORT sont fixes par docker-compose.prod.yml (buildr-db:5432).
DB_NAME=buildr
DB_USER=buildr
# openssl rand -hex 24
DB_PASSWORD=

# --- Auth ---
# openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_EXPIRES=15m
# openssl rand -hex 32 — doit etre IDENTIQUE a EXPO_PUBLIC_API_KEY (app mobile)
API_KEY=

# --- Emails : Resend (https://resend.com) ---
# Laisser SMTP_* vides en prod : si RESEND_API_KEY est defini, Resend est utilise.
RESEND_API_KEY=
SMTP_FROM=noreply@getbuildr.fr
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- CORS : domaines web autorises (separes par des virgules) ---
# Les apps natives n'envoient pas d'Origin, elles ne sont pas concernees.
CORS_ORIGINS=https://getbuildr.fr,https://app.getbuildr.fr

# --- URL publique (deep links / liens web dans les emails) ---
APP_URL=https://app.getbuildr.fr

# --- Stockage fichiers ---
# 'local' = disque du conteneur (volume buildr_uploads). Le mode 's3' n'est
# pas encore implemente cote code (a faire avant de scaler).
STORAGE_MODE=local
S3_BUCKET=
S3_REGION=fr-par
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Integrations calendrier (optionnel) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
CALENDAR_OAUTH_REDIRECT_BASE=https://api.getbuildr.fr
# openssl rand -hex 32
CALENDAR_ENCRYPTION_KEY=
