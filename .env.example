NODE_ENV=development
PORT=3000
HOST=0.0.0.0

DB_HOST=localhost
DB_PORT=5432
DB_NAME=buildr
DB_USER=postgres
DB_PASSWORD=postgres

JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRES=15m
API_KEY=change-me-in-production

# Email transactionnel. En production : Scaleway Transactional Email (France).
# L'identifiant est l'ID DU PROJET Scaleway, pas une adresse email, et le mot de
# passe est la cle secrete d'une cle d'API ayant les droits TEM sur ce projet.
SMTP_HOST=smtp.tem.scaleway.com
SMTP_PORT=587
SMTP_USER=<project-id-scaleway>
SMTP_PASSWORD=<secret-key-api>
SMTP_FROM=noreply@getbuildr.fr
# Base publique du dashboard web : liens d'invitation et de reset envoyes par email
APP_URL=http://localhost:3001
# Base publique de cette API : URLs des photos et documents. Doit pointer sur
# l'API, jamais sur le dashboard. Vide => retombe sur APP_URL.
API_PUBLIC_URL=http://localhost:3000

# local = disque du serveur (dev) ; s3 = Scaleway Object Storage (production)
STORAGE_MODE=local
# Renseigner uniquement si STORAGE_MODE=s3
S3_BUCKET=
S3_REGION=fr-par
S3_ENDPOINT=https://s3.fr-par.scw.cloud
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Calendar integrations (OAuth + iCal)
# Google : https://console.cloud.google.com/apis/credentials (Web app + Calendar API enabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Outlook : https://entra.microsoft.com (App registration, redirect URI Web)
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
# Base URL public utilisee pour les redirect_uri OAuth (ngrok/cloudflared en dev distant)
CALENDAR_OAUTH_REDIRECT_BASE=http://localhost:3001
# Cle de chiffrement AES-256 pour les refresh_token (32 octets en hex = 64 chars)
# Generer : openssl rand -hex 32
CALENDAR_ENCRYPTION_KEY=
